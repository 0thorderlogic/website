---
import Layout from "../layout/Layout.astro";
import CalendarGrid from "../components/calendar/CalendarGrid.astro";
import CalendarHeader from "../components/calendar/CalendarHeader.astro";
import CalendarModal from "../components/calendar/CalendarModal.astro";
import { CALENDAR_IDS } from "../lib/calendar/constants";

const apiKey = import.meta.env.GOOGLE_API_KEY;
const calendarId = import.meta.env.GOOGLE_CALENDAR_ID;
const hasCredentials = Boolean(apiKey && calendarId);
---

<Layout title="Calendar">
  <section class="w-full space-y-8">
    {
      !hasCredentials ? (
        <p class="text-red-500">
          Google Calendar API key or Calendar ID is missing in environment variables.
        </p>
      ) : (
        <div id={CALENDAR_IDS.container}>
          <CalendarHeader />
          <CalendarGrid />
        </div>
      )
    }
  </section>

  <CalendarModal />

  {
    hasCredentials && (
      <>
        <script
          id="calendar-credentials"
          type="application/json"
          set:html={JSON.stringify({ apiKey, calendarId })}
        />
        <script>
          import {initCalendarWithFetch} from "../scripts/calendar";
          initCalendarWithFetch("calendar-credentials");
        </script>
      </>
    )
  }
</Layout>

<style is:global>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
