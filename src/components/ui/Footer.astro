---
import { name } from "../../../consts";
---

<footer class="mt-auto py-6 border-t border-slate-400/20 text-slate-400 text-xs">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
    <!-- License -->
    <p class="m-0 flex items-center gap-1.5 flex-wrap">
      <span>CC BY-SA 4.0</span>
      <img
        src="https://mirrors.creativecommons.org/presskit/icons/cc.svg"
        alt="CC"
        aria-hidden="true"
        class="size-3.5 opacity-70"
      />
      <img
        src="https://mirrors.creativecommons.org/presskit/icons/by.svg"
        alt="BY"
        aria-hidden="true"
        class="size-3.5 opacity-70"
      />
      <img
        src="https://mirrors.creativecommons.org/presskit/icons/sa.svg"
        alt="SA"
        aria-hidden="true"
        class="size-3.5 opacity-70"
      />
    </p>

    <!-- Not by AI badge — center -->
    <a target="_blank" href="https://notbyai.fyi" class="shrink-0">
      <img
        class="w-36 opacity-70 hover:opacity-100 transition-opacity"
        src="/notbyai.png"
        alt="Not by AI badge"
      />
    </a>

    <!-- Source links -->
    <p class="m-0 text-center sm:text-right">
      <a href="https://github.com/0thorderlogic/man-pages" target="_blank">Theme source</a>
      <span class="opacity-40 mx-1">|</span>
      <a href="https://github.com/0thorderlogic/a115.xyz" target="_blank">Site source</a>
      <span class="opacity-40 mx-1">|</span>
      <span>© 2016-2026</span>
    </p>
  </div>
</footer>
